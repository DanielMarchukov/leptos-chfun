# Build outputs — produced inside the container, not from host
target/
dist/

# VCS
.git/
.gitattributes
.gitignore

# CI / docs / editor — not needed at build time
.github/
README.md
LICENSE
*.md
.vscode/
.idea/
.editorconfig

# Local env / secrets — must never land in the image's site_root
.env
.env.*
!.env.example

# Local planning/scaffolding — not needed at build time, may contain
# unreviewed notes; excluded so it can never be copied into the image.
plan.md
docs/
.superpowers/
.claude/

# OS junk
.DS_Store
Thumbs.db
